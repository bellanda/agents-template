# ----------------------------------------------------------------------------
# 🌐 SERVER CONFIGURATION -> 🚀 GRANIAN (RUST HTTP SERVER)
# ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Exigidas por `getenv_or_raise_exception` em config/api.py — sem elas o import de
# `config.api` levanta e a API não sobe. Não têm default no código de propósito: o servidor
# de produção não deve herdar silenciosamente um palpite.
GRANIAN_INTERFACE=asgi
GRANIAN_HTTP=auto
GRANIAN_LOOP=uvloop
GRANIAN_WORKERS=4

# ----------------------------------------------------------------------------
# 🛢️ DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
POSTGRES_DB=agents_template
POSTGRES_USER=agents_template
# 👉 Generate a secure secret key:
# >> uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Mesma regra: config/database.py as exige no import. `MAX_SIZE` é por PROCESSO — com
# GRANIAN_WORKERS=4 são até 40 conexões no Postgres, que tem 100 por default.
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_MAX_QUERIES=50000
POSTGRES_POOL_MAX_INACTIVE_CONNECTION_LIFETIME=300
POSTGRES_POOL_COMMAND_TIMEOUT=60
POSTGRES_POOL_TIMEOUT=30

# ----------------------------------------------------------------------------
# 🧠 AI
# ----------------------------------------------------------------------------
# Chat é só OpenRouter (gateway único); Groq entra só na transcrição de áudio (Whisper).
# Lidas via os.getenv em core/agents/{custom_providers,media}.py. Chave de outro provedor seria
# uma rota de inferência a mais para auditar — não adicione sem decisão explícita.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ----------------------------------------------------------------------------
# 🪵 LOGGING (opcionais — core/logging.py tem default para todas)
# ----------------------------------------------------------------------------
# SERVICE_NAME=agents-template
# APP_ENV=local
# LOG_LEVEL=INFO
# LOG_FORMAT=auto
