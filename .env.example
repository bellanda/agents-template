# 🌎 App environment — picks config/app/{env}.yaml + the compose override (nginx topology is INGRESS_MODE).
ENVIRONMENT=local

# 🚪 Nginx ingress topology
#   loopback → local dev: everything on 127.0.0.1:19080 (plain HTTP)
#   gateway  → many services on one host, behind a shared central gateway (it terminates TLS)
INGRESS_MODE=loopback

# 👤 Container process UID (GID=1000) — set to `id -u` if your Docker user differs, so it owns the bind mounts.
APP_UID=1000

# 🛢️ Postgres password (used by compose: postgres, migrate, backend DSN). Generate:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
# DSN for host-only dev (uvicorn + dbmate CLI). Carries the password, so it is a secret; all other
# DB config (pool) lives in config/app/{env}.yaml > postgres:. In docker, compose overrides it.
DATABASE_URL=postgres://agents_template:CHANGEME@localhost:5432/agents_template?sslmode=disable

# 🧠 AI provider keys — exactly two: OpenRouter is the single chat gateway (text/image/video,
# GLM 5.3 Flash) and Groq is audio transcription only (Whisper). Another provider's key would be one
# more inference route to audit — do not add one without an explicit decision.
# Endpoint/attribution config is in config/app/{env}.yaml > openrouter:.
OPENROUTER_API_KEY=
GROQ_API_KEY=
